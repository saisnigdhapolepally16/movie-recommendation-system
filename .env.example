# Copy this file to .env and fill in your own TMDB API key to enable
# movie poster images in the app. This is OPTIONAL -- the recommendation
# engine itself runs entirely locally and works fully without it.
#
# Get a free API key at: https://www.themoviedb.org/settings/api
#
# Never commit your real .env file or share your API key publicly.

TMDB_API_KEY=your_tmdb_api_key_here
